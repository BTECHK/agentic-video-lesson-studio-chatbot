{
  "name": "agentic-video-lesson-studio-chatbot",
  "version": "1.0.0",
  "description": "AI content production system for Sample Academy",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render src/index.ts",
    "build": "remotion bundle src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:fast": "npm run typecheck && npm run lint && npm run test",
    "check": "npm run check:fast",
    "check:build": "npm run build",
    "check:content": "npm run validate:content",
    "check:e2e": "npm --prefix chatbot run check:e2e",
    "check:all": "npm run check:fast && npm run check:content && npm --prefix chatbot run check:fast",
    "verify:render": "tsx scripts/verify-render.ts",
    "gate:lesson": "tsx scripts/gate-lesson.ts",
    "gate:status": "tsx scripts/gate-status.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:audit": "vitest run --reporter=json --outputFile=.test-results/results.json",
    "validate:content": "tsx scripts/validate-content.ts",
    "ingest:poll": "docker compose run --rm ingest npx tsx scripts/ingest.ts --mode poll",
    "ingest:search": "docker compose run --rm ingest npx tsx scripts/ingest.ts --mode search",
    "ingest:schedule": "docker compose up -d ingest",
    "ingest:unschedule": "docker compose stop ingest",
    "ingest:llm": "npx tsx scripts/ingest.ts --mode llm-extract",
    "tts:build": "docker compose build tts",
    "tts:lesson": "tsx scripts/synthesize-lesson.ts",
    "align:lesson": "tsx scripts/align-lesson.ts",
    "regenerate": "tsx scripts/regenerate.ts",
    "publish:lesson": "tsx scripts/publish-lesson.ts"
  },
  "keywords": [],
  "author": "",
  "license": "PolyForm-Noncommercial-1.0.0",
  "dependencies": {
    "@fontsource/syne": "^5.2.7",
    "@remotion/bundler": "^4.0.460",
    "@remotion/captions": "^4.0.460",
    "@remotion/cli": "^4.0.460",
    "@remotion/google-fonts": "^4.0.460",
    "@remotion/renderer": "^4.0.460",
    "@remotion/transitions": "^4.0.460",
    "cheerio": "^1.2.0",
    "p-limit": "^7.3.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "remotion": "^4.0.460",
    "robots-parser": "^3.0.1",
    "sharp": "^0.34.5",
    "tsx": "^4.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.7.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.6"
  }
}
