FROM node:22-bookworm-slim

# Chrome dependencies + fontconfig (same as render for consistency)
RUN apt-get update && apt-get install -y --no-install-recommends \
  libnss3 libdbus-1-3 libatk1.0-0 libgbm-dev libasound2 \
  libxrandr2 libxkbcommon-dev libxfixes3 libxcomposite1 \
  libxdamage1 libatk-bridge2.0-0 libpango-1.0-0 libcairo2 \
  libcups2 fontconfig \
  && rm -rf /var/lib/apt/lists/*

# Bundle Syne font per D-08
COPY public/fonts/*.ttf /usr/share/fonts/syne/
RUN fc-cache -fv

# Use built-in non-root node user (uid 1000) for security (T-01-01)
WORKDIR /app

COPY package*.json ./
RUN npm install
RUN npx remotion browser ensure

COPY . .
RUN chown -R node:node /app

USER node
# Remotion Studio per D-02/VERI-02: headed browser mode with hot reload, timeline scrubbing, composition selection
CMD ["npx", "remotion", "studio", "--port", "3000"]
