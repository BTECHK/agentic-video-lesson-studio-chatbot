# Upload ONLY what the Tutor bot image needs (bot/ + content/tools/).
# Nested-whitelist idiom: ignore a level, re-include the one child you want.

# Ignore all top-level entries…
/*

# …re-include the bot service
!/bot

# …re-include content, then ignore its children except tools
!/content
/content/*
!/content/tools

# Junk inside allowed dirs
bot/node_modules
bot/.test-results
bot/.env
bot/.env.*