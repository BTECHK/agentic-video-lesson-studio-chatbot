  <diagram name="Video Pipeline (one page)" id="vid-pipe-1page">
    <mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2240" pageHeight="1480" math="0" shadow="0" background="#EDE8E3">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Sample Academy — Video Generation Pipeline · phases · relative timing · parallel vs serial · dependencies · bottlenecks (one-page comparison)" style="text;html=1;fontStyle=1;fontSize=17;fontColor=#8B2635;align=left;" vertex="1" parent="1"><mxGeometry x="14" y="12" width="1500" height="30" as="geometry" /></mxCell>
        <mxCell id="legend" value="serial → chain   ·   ∥ parallel (stacked)   ·   crimson = bottleneck   ·   green = improvement   ·   amber = unavoidable cost   ·   dashed = loop / fan-out" style="text;html=1;fontSize=12;fontColor=#1C1C1C;align=left;" vertex="1" parent="1"><mxGeometry x="14" y="44" width="1500" height="20" as="geometry" /></mxCell>

        <!-- ===== PHASE / TIME HEADER ===== -->
        <mxCell id="ph1" value="① PLAN + BUILD&#10;~20–40 min total · PARALLEL ∥ across lessons" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EDE8E3;strokeColor=#D8CFC4;fontStyle=1;fontColor=#1C1C1C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="74" width="430" height="44" as="geometry" /></mxCell>
        <mxCell id="ph2" value="② AUDIO&#10;~3–8 min/lesson · ∥" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EDE8E3;strokeColor=#D8CFC4;fontStyle=1;fontColor=#1C1C1C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="645" y="74" width="235" height="44" as="geometry" /></mxCell>
        <mxCell id="ph3" value="③ RENDER — SERIAL · ~30 min × N lessons  ◀ THE BOTTLENECK (hours for the full batch)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F7E6E7;strokeColor=#E0B8BC;fontStyle=1;fontColor=#8B2635;fontSize=11;" vertex="1" parent="1"><mxGeometry x="885" y="74" width="595" height="44" as="geometry" /></mxCell>
        <mxCell id="ph4" value="④ GATE + QC&#10;~2 min/lesson + QC ~18 min" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EDE8E3;strokeColor=#D8CFC4;fontStyle=1;fontColor=#1C1C1C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1485" y="74" width="335" height="44" as="geometry" /></mxCell>
        <mxCell id="ph5" value="⑤ DELIVER&#10;~1 min/lesson (network copy)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EDE8E3;strokeColor=#D8CFC4;fontStyle=1;fontColor=#1C1C1C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1825" y="74" width="295" height="44" as="geometry" /></mxCell>

        <!-- ===== LANE BACKGROUNDS ===== -->
        <mxCell id="laneSrcBg" value="" style="rounded=0;html=1;fillColor=#F2ECE5;strokeColor=#D8CFC4;" vertex="1" parent="1"><mxGeometry x="200" y="125" width="1920" height="110" as="geometry" /></mxCell>
        <mxCell id="laneBuildBg" value="" style="rounded=0;html=1;fillColor=#F2ECE5;strokeColor=#D8CFC4;" vertex="1" parent="1"><mxGeometry x="200" y="240" width="1920" height="175" as="geometry" /></mxCell>
        <mxCell id="laneAudioBg" value="" style="rounded=0;html=1;fillColor=#F2ECE5;strokeColor=#D8CFC4;" vertex="1" parent="1"><mxGeometry x="200" y="420" width="1920" height="110" as="geometry" /></mxCell>
        <mxCell id="laneRenderBg" value="" style="rounded=0;html=1;fillColor=#F7E6E7;strokeColor=#E0B8BC;" vertex="1" parent="1"><mxGeometry x="200" y="535" width="1920" height="185" as="geometry" /></mxCell>
        <mxCell id="laneGateBg" value="" style="rounded=0;html=1;fillColor=#F2ECE5;strokeColor=#D8CFC4;" vertex="1" parent="1"><mxGeometry x="200" y="725" width="1920" height="175" as="geometry" /></mxCell>
        <mxCell id="laneDeliverBg" value="" style="rounded=0;html=1;fillColor=#E8E6E0;strokeColor=#C9C2B6;" vertex="1" parent="1"><mxGeometry x="200" y="905" width="1920" height="110" as="geometry" /></mxCell>
        <mxCell id="laneOrchBg" value="" style="rounded=0;html=1;fillColor=#EFE7E8;strokeColor=#E0B8BC;" vertex="1" parent="1"><mxGeometry x="200" y="1020" width="1920" height="95" as="geometry" /></mxCell>

        <!-- ===== LANE LABELS ===== -->
        <mxCell id="lblSrc" value="SOURCES" style="rounded=0;html=1;fillColor=#E8E6E0;strokeColor=#C9C2B6;fontStyle=1;fontColor=#8B2635;fontSize=12;" vertex="1" parent="1"><mxGeometry x="14" y="125" width="184" height="110" as="geometry" /></mxCell>
        <mxCell id="lblBuild" value="PLAN + BUILD&#10;(agents ∥)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E8E6E0;strokeColor=#C9C2B6;fontStyle=1;fontColor=#8B2635;fontSize=12;" vertex="1" parent="1"><mxGeometry x="14" y="240" width="184" height="175" as="geometry" /></mxCell>
        <mxCell id="lblAudio" value="AUDIO&#10;(∥)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E8E6E0;strokeColor=#C9C2B6;fontStyle=1;fontColor=#8B2635;fontSize=12;" vertex="1" parent="1"><mxGeometry x="14" y="420" width="184" height="110" as="geometry" /></mxCell>
        <mxCell id="lblRender" value="RENDER MACHINE&#10;(SERIAL · bottleneck)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F2D6D9;strokeColor=#E0B8BC;fontStyle=1;fontColor=#8B2635;fontSize=12;" vertex="1" parent="1"><mxGeometry x="14" y="535" width="184" height="185" as="geometry" /></mxCell>
        <mxCell id="lblGate" value="GATE + QC" style="rounded=0;html=1;fillColor=#E8E6E0;strokeColor=#C9C2B6;fontStyle=1;fontColor=#8B2635;fontSize=12;" vertex="1" parent="1"><mxGeometry x="14" y="725" width="184" height="175" as="geometry" /></mxCell>
        <mxCell id="lblDeliver" value="DELIVER&#10;(Google Drive)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E8E6E0;strokeColor=#C9C2B6;fontStyle=1;fontColor=#1C1C1C;fontSize=12;" vertex="1" parent="1"><mxGeometry x="14" y="905" width="184" height="110" as="geometry" /></mxCell>
        <mxCell id="lblOrch" value="ORCHESTRATION&#10;(Claude + Codex)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E8E6E0;strokeColor=#C9C2B6;fontStyle=1;fontColor=#8B2635;fontSize=12;" vertex="1" parent="1"><mxGeometry x="14" y="1020" width="184" height="95" as="geometry" /></mxCell>

        <!-- ===== SOURCES ===== -->
        <mxCell id="src" value="Outline (DOCX) = SCOPE  ·  Content repo + Drive = TASTE  ·  Brand contracts + tokens.ts = DESIGN (18 scene types · linen/crimson/Syne/4px)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#EDE8E3;strokeColor=#8B2635;fontColor=#1C1C1C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="150" width="430" height="60" as="geometry" /></mxCell>

        <!-- ===== PLAN + BUILD (parallel) ===== -->
        <mxCell id="b1" value="lesson-plan → lesson plan&#10;+ scene-contract.json" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FDFBF9;strokeColor=#1C1C1C;fontColor=#1C1C1C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="258" width="195" height="50" as="geometry" /></mxCell>
        <mxCell id="bacc" value="Gate A · accuracy sweep&#10;(claims vs vendor docs)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFF7E6;strokeColor=#8B2635;fontColor=#1C1C1C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="320" width="195" height="46" as="geometry" /></mxCell>
        <mxCell id="b2" value="lesson.json — L1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FDFBF9;strokeColor=#1C1C1C;fontColor=#1C1C1C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="430" y="258" width="200" height="26" as="geometry" /></mxCell>
        <mxCell id="b3" value="lesson.json — L2   ∥" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FDFBF9;strokeColor=#1C1C1C;fontColor=#1C1C1C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="430" y="290" width="200" height="26" as="geometry" /></mxCell>
        <mxCell id="b4" value="lesson.json — …Lₙ  (all lessons in parallel)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FDFBF9;strokeColor=#1C1C1C;fontColor=#1C1C1C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="430" y="322" width="200" height="26" as="geometry" /></mxCell>
        <mxCell id="bnote" value="narration · word budget 2.96 w/s · generate-script --check ≥ 75%" style="text;html=1;fontSize=10;fontColor=#6B6B6B;align=left;" vertex="1" parent="1"><mxGeometry x="210" y="372" width="420" height="20" as="geometry" /></mxCell>

        <!-- ===== AUDIO ===== -->
        <mxCell id="au" value="tts:lesson → align:lesson&#10;ElevenLabs / Google / Kokoro&#10;(per lesson · parallelizable)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FDFBF9;strokeColor=#1C1C1C;fontColor=#1C1C1C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="655" y="442" width="215" height="70" as="geometry" /></mxCell>

        <!-- ===== RENDER (serial chain) ===== -->
        <mxCell id="bnnote" value="◀ BOTTLENECK · everything funnels here · one machine, one lesson at a time · cannot parallelize on this box" style="text;html=1;fontStyle=1;fontColor=#8B2635;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="892" y="540" width="700" height="18" as="geometry" /></mxCell>
        <mxCell id="r1" value="Render L1&#10;~30 min" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#8B2635;strokeColor=#8B2635;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="892" y="564" width="135" height="46" as="geometry" /></mxCell>
        <mxCell id="r2" value="Render L2&#10;~30 min" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#8B2635;strokeColor=#8B2635;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1042" y="564" width="135" height="46" as="geometry" /></mxCell>
        <mxCell id="r3" value="Render L3&#10;~30 min" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#8B2635;strokeColor=#8B2635;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1192" y="564" width="135" height="46" as="geometry" /></mxCell>
        <mxCell id="rn" value="… × N&#10;(serial)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#8B2635;strokeColor=#8B2635;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1342" y="564" width="80" height="46" as="geometry" /></mxCell>
        <mxCell id="rspec" value="Remotion · SSAA 2× · CRF 18 · x264 slow · BT.709 · concurrency-capped · 70-min watchdog" style="text;html=1;fontSize=10;fontColor=#8B2635;align=left;" vertex="1" parent="1"><mxGeometry x="892" y="612" width="560" height="16" as="geometry" /></mxCell>
        <mxCell id="crash" value="✗ CRASH CEILING — ffmpeg 0xC0000142 (Windows desktop-heap / memory) kills a render after ~3–4 lessons on a loaded box → 'browser launch' fails cascade for the rest. Hit on 3 batches this run. Real fix = dedicated/clean render box." style="shape=note;html=1;whiteSpace=wrap;fillColor=#FBEDEE;strokeColor=#8B2635;fontColor=#8B2635;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1492" y="540" width="320" height="78" as="geometry" /></mxCell>

        <!-- ===== GATE + QC ===== -->
        <mxCell id="g1" value="gate:status (A·B·C·L·T)&#10;+ gate:motion + gate:media + volumedetect&#10;(AFTER render — never during)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FDFBF9;strokeColor=#1C1C1C;fontColor=#1C1C1C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1495" y="742" width="305" height="64" as="geometry" /></mxCell>
        <mxCell id="g2" value="keyframes-review → Claude Design QC&#10;(∥ vision agents) → fix → re-render v3" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FDFBF9;strokeColor=#1C1C1C;fontColor=#1C1C1C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1495" y="814" width="305" height="64" as="geometry" /></mxCell>

        <!-- ===== DELIVER ===== -->
        <mxCell id="d1" value="publish:drive (gate-green only)&#10;Video + Script + Lesson Plan&#10;+ v2 / v3 alongside originals" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#1C1C1C;strokeColor=#1C1C1C;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1835" y="928" width="275" height="68" as="geometry" /></mxCell>

        <!-- ===== ORCHESTRATION ===== -->
        <mxCell id="o1" value="/goal two-model loop spans EVERY phase:   STATE.json ledger · hourly heartbeats · resumable after teardown · Claude builder + checker (∥) · Codex independent verify at the gates · checkpoint commits on branch (NO push)" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#EDE8E3;strokeColor=#8B2635;fontColor=#1C1C1C;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="210" y="1035" width="1900" height="62" as="geometry" /></mxCell>

        <!-- ===== EFFICIENCY ROW ===== -->
        <mxCell id="impttl" value="EFFICIENCY — improvement options (green) · unavoidable quality costs (amber)" style="text;html=1;fontStyle=1;fontSize=14;fontColor=#8B2635;align=left;" vertex="1" parent="1"><mxGeometry x="14" y="1128" width="900" height="24" as="geometry" /></mxCell>
        <mxCell id="imp1" value="⚡ KILL THE BOTTLENECK (highest impact)&#10;• Cloud / render farm — N machines render in parallel (≈ N× faster)&#10;• Dedicated headless render box — no user Chrome tabs → ends the 0xC0000142 crash&#10;• Free RAM / reboot before a batch" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#E8F0E3;strokeColor=#5C8A4A;fontColor=#1C1C1C;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="14" y="1156" width="420" height="150" as="geometry" /></mxCell>
        <mxCell id="imp2" value="⚡ RENDER LESS WORK&#10;• Scene-level cache — re-render only CHANGED scenes, not whole lessons&#10;• 1.5× supersample for QA proofs; 2× only for final masters&#10;• Keyframe-only proof render for QC (skip full encode)" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#E8F0E3;strokeColor=#5C8A4A;fontColor=#1C1C1C;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="448" y="1156" width="420" height="150" as="geometry" /></mxCell>
        <mxCell id="imp3" value="⚡ FAIL-SAFE BATCHING&#10;• Batches ≤ 3 + a fresh process each (avoids the cumulative crash)&#10;• Per-lesson done-signal — a crash loses 1 lesson, not the batch&#10;• Auto-retry failed lessons in a fresh process" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#E8F0E3;strokeColor=#5C8A4A;fontColor=#1C1C1C;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="882" y="1156" width="420" height="150" as="geometry" /></mxCell>
        <mxCell id="imp4" value="⚡ OVERLAP SAFE WORK&#10;• Build + TTS + align already run parallel (agents) ✓&#10;• Run gate + keyframe-extract on a 2nd box while the render box keeps going&#10;• Async / batched Drive publish" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#E8F0E3;strokeColor=#5C8A4A;fontColor=#1C1C1C;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1316" y="1156" width="420" height="150" as="geometry" /></mxCell>
        <mxCell id="imp5" value="⚠ SLOW BUT UNAVOIDABLE (quality floor)&#10;• x264 'slow' + 2× supersample = crisp 1080p — final masters need it&#10;• TTS vendor API synthesis latency&#10;• 50–90 MB MP4 network copy to Drive&#10;Trim only for drafts, not final.&#10;✗ Remotion components do NOT sync to Claude Design (frame-driven)." style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#FBF1DD;strokeColor=#C79A3A;fontColor=#1C1C1C;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1750" y="1156" width="360" height="150" as="geometry" /></mxCell>

        <!-- ===== EDGES ===== -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1C1C1C;endArrow=block;" edge="1" parent="1" source="src" target="b1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1C1C1C;endArrow=block;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2b" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9A9A9A;endArrow=block;dashed=1;" edge="1" parent="1" source="b1" target="b3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2c" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9A9A9A;endArrow=block;dashed=1;" edge="1" parent="1" source="b1" target="b4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="narration → audio" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1C1C1C;endArrow=block;fontSize=9;" edge="1" parent="1" source="b3" target="au"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="REQUIRES all lesson.json + audio ready&#10;(barrier) → then render serially" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8B2635;endArrow=block;fontStyle=1;fontColor=#8B2635;fontSize=9;" edge="1" parent="1" source="au" target="r1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8B2635;endArrow=block;" edge="1" parent="1" source="r1" target="r2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8B2635;endArrow=block;" edge="1" parent="1" source="r2" target="r3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8B2635;endArrow=block;" edge="1" parent="1" source="r3" target="rn"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="each render done → gate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1C1C1C;endArrow=block;fontSize=9;" edge="1" parent="1" source="rn" target="g1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="green → DELIVER" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1C1C1C;endArrow=block;fontStyle=1;fontSize=9;" edge="1" parent="1" source="g1" target="d1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1C1C1C;endArrow=block;" edge="1" parent="1" source="g1" target="g2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" value="↺ revamp loop — re-render v3 (back to the serial render lane)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8B2635;dashed=1;endArrow=block;fontColor=#8B2635;fontStyle=1;fontSize=9;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="g2" target="rn"><mxGeometry relative="1" as="geometry" /></mxCell>
