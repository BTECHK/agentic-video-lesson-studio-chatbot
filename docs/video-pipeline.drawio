<mxfile host="app.diagrams.net" agent="video-pipeline" version="24.0.0">
  <diagram name="Video Generation Pipeline" id="vid-pipe-1">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1640" math="0" shadow="0" background="#EDE8E3">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ============ PHASE BANDS (background) ============ -->
        <mxCell id="bandA" value="PHASE 1 · INPUTS  (sources of truth)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2ECE5;strokeColor=#D8CFC4;verticalAlign=top;align=left;fontStyle=1;fontSize=13;fontColor=#8B2635;spacingLeft=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="40" y="85" width="1220" height="165" as="geometry" /></mxCell>
        <mxCell id="bandB" value="PHASE 2 · PLAN  (per lesson, agentic)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2ECE5;strokeColor=#D8CFC4;verticalAlign=top;align=left;fontStyle=1;fontSize=13;fontColor=#8B2635;spacingLeft=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="40" y="292" width="1220" height="180" as="geometry" /></mxCell>
        <mxCell id="bandC" value="PHASE 3 · BUILD / CONVERT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2ECE5;strokeColor=#D8CFC4;verticalAlign=top;align=left;fontStyle=1;fontSize=13;fontColor=#8B2635;spacingLeft=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="40" y="482" width="1220" height="140" as="geometry" /></mxCell>
        <mxCell id="bandD" value="PHASE 4 · AUDIO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2ECE5;strokeColor=#D8CFC4;verticalAlign=top;align=left;fontStyle=1;fontSize=13;fontColor=#8B2635;spacingLeft=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="40" y="632" width="1220" height="185" as="geometry" /></mxCell>
        <mxCell id="bandE" value="PHASE 5 · RENDER  ◀ bottleneck (serial · owns the machine)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2E3E3;strokeColor=#E0B8BC;verticalAlign=top;align=left;fontStyle=1;fontSize=13;fontColor=#8B2635;spacingLeft=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="40" y="827" width="1220" height="200" as="geometry" /></mxCell>
        <mxCell id="bandF" value="PHASE 6 · GATE  (run AFTER render, never during)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2ECE5;strokeColor=#D8CFC4;verticalAlign=top;align=left;fontStyle=1;fontSize=13;fontColor=#8B2635;spacingLeft=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="40" y="1037" width="1220" height="165" as="geometry" /></mxCell>
        <mxCell id="bandG" value="PHASE 7 · QC / REVAMP LOOP  (the v3 cycle)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2ECE5;strokeColor=#D8CFC4;verticalAlign=top;align=left;fontStyle=1;fontSize=13;fontColor=#8B2635;spacingLeft=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="40" y="1212" width="1220" height="215" as="geometry" /></mxCell>
        <mxCell id="bandH" value="PHASE 8 · DELIVER" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8E6E0;strokeColor=#C9C2B6;verticalAlign=top;align=left;fontStyle=1;fontSize=13;fontColor=#1C1C1C;spacingLeft=14;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="40" y="1437" width="1220" height="150" as="geometry" /></mxCell>

        <!-- ============ START + TRACKS ============ -->
        <mxCell id="start" value="BIG JOB — batch render: all modules · Sizzle" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#1C1C1C;fontColor=#FFFFFF;strokeColor=#1C1C1C;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="32" width="510" height="42" as="geometry" /></mxCell>
        <mxCell id="tracks" value="Every track runs the SAME per-lesson pipeline below.&#10;Sizzle = render:sizzle (16×9 + 9×16)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#D8CFC4;fontColor=#1C1C1C;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="660" y="26" width="540" height="52" as="geometry" /></mxCell>

        <!-- ============ PHASE 1 · INPUTS ============ -->
        <mxCell id="inA1" value="① Course OUTLINE (DOCX)&#10;→ course-map.json · delivery-types.json · OUTLINE.md&#10;&#10;SETS SCOPE — the only source of WHAT is in a lesson" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EDE8E3;strokeColor=#8B2635;fontColor=#1C1C1C;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="122" width="380" height="112" as="geometry" /></mxCell>
        <mxCell id="inA2" value="② Content repo + Drive 'Content Development'&#10;frameworks · teaching style · voice&#10;&#10;SETS TASTE — HOW it is built (not what is in)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EDE8E3;strokeColor=#8B2635;fontColor=#1C1C1C;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="455" y="122" width="360" height="112" as="geometry" /></mxCell>
        <mxCell id="inA3" value="③ Brand contracts + src/brand/tokens.ts&#10;scene-type-catalog · motion-contract · brand-tokens-ref · interactive-mandate&#10;&#10;SETS DESIGN — linen/crimson/Syne/4px · 18 scene types" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EDE8E3;strokeColor=#8B2635;fontColor=#1C1C1C;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="830" y="122" width="390" height="112" as="geometry" /></mxCell>

        <!-- ============ FOR EACH LESSON ============ -->
        <mxCell id="forEach" value="▼  FOR EACH LESSON  (loop over all lessons in the batch)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#8B2635;strokeColor=#8B2635;fontColor=#FFFFFF;fontStyle=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="256" width="380" height="26" as="geometry" /></mxCell>

        <!-- ============ PHASE 2 · PLAN ============ -->
        <mxCell id="B1" value="lesson-plan skill  →  LESSON PLAN&#10;(load-bearing artifact; learner-journey cascade from the objective)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDFBF9;strokeColor=#1C1C1C;fontColor=#1C1C1C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="322" width="380" height="54" as="geometry" /></mxCell>
        <mxCell id="B2" value="scene-contract.json (18 scene types) + storyboard.md&#10;(Claude composes the lesson dynamically from the inputs above)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDFBF9;strokeColor=#1C1C1C;fontColor=#1C1C1C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="392" width="380" height="56" as="geometry" /></mxCell>
        <mxCell id="acc" value="GATE A · ACCURACY SWEEP&#10;(accuracy-sweep)&#10;verify every tool / pricing / feature claim vs&#10;OFFICIAL vendor docs → confirm · soften · drop.&#10;No human sign-off required." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#8B2635;fontColor=#1C1C1C;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="855" y="328" width="360" height="116" as="geometry" /></mxCell>

        <!-- ============ PHASE 3 · BUILD ============ -->
        <mxCell id="C1" value="Convert  →  render-strict lesson.json&#10;(content/schemas/scene-types.ts · planning-to-render.md seam)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDFBF9;strokeColor=#1C1C1C;fontColor=#1C1C1C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="510" width="380" height="50" as="geometry" /></mxCell>
        <mxCell id="C2" value="Author narration · word budget 2.96 words/sec&#10;(generate-script --check must pass ≥ 75% of target)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDFBF9;strokeColor=#1C1C1C;fontColor=#1C1C1C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="566" width="380" height="46" as="geometry" /></mxCell>

        <!-- ============ PHASE 4 · AUDIO ============ -->
        <mxCell id="D1" value="tts:lesson  (synthesize-lesson.ts)&#10;ElevenLabs  →  Google Voice  →  Kokoro fallback" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDFBF9;strokeColor=#1C1C1C;fontColor=#1C1C1C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="668" width="380" height="52" as="geometry" /></mxCell>
        <mxCell id="D2" value="align:lesson  —  sync audio ↔ scene timings + captions" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDFBF9;strokeColor=#1C1C1C;fontColor=#1C1C1C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="736" width="380" height="44" as="geometry" /></mxCell>
        <mxCell id="dnote" value="EDIT-SAFETY (avoid SILENT render):&#10;del content/lessons/&lt;id&gt;/.regen-cache.json&#10;→ regenerate → align → regenerate.&#10;ALWAYS volumedetect every MP4&#10;(mean −20..−35 dB, never −91 = silent)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#D8CFC4;fontColor=#1C1C1C;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="855" y="660" width="360" height="120" as="geometry" /></mxCell>

        <!-- ============ PHASE 5 · RENDER ============ -->
        <mxCell id="E1" value="RENDER — render-lesson.ts  →  out/&lt;id&gt;.mp4&#10;Remotion · SSAA 2× · CRF 18 · x264 slow · BT.709&#10;serial queue · RENDER_CONCURRENCY cap · 70-min watchdog" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#8B2635;strokeColor=#8B2635;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="866" width="380" height="70" as="geometry" /></mxCell>
        <mxCell id="enote" value="RENDERS OWN THE MACHINE&#10;• serial — one lesson at a time (~12–46 min each)&#10;• NEVER run gates / tests / keyframes during a live render&#10;• cap concurrency on a loaded box (desktop-heap crash 0xC0000142)&#10;• key 'done' to the batch exit signal, not a wall-clock timer" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FBEDEE;strokeColor=#E0B8BC;fontColor=#1C1C1C;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="855" y="858" width="365" height="128" as="geometry" /></mxCell>
        <mxCell id="edec" value="render OK?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FDFBF9;strokeColor=#8B2635;fontColor=#1C1C1C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="545" y="952" width="190" height="60" as="geometry" /></mxCell>

        <!-- ============ PHASE 6 · GATE ============ -->
        <mxCell id="F1" value="GATES (after each render):&#10;gate:status → A·B·C·L·T (fidelity / teaching / watch / layout / timing)&#10;gate:motion (activePct ≥ 0.6) · gate:media (audible · BT.709) · volumedetect" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDFBF9;strokeColor=#1C1C1C;fontColor=#1C1C1C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="1062" width="380" height="72" as="geometry" /></mxCell>
        <mxCell id="fdec" value="all gates green?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FDFBF9;strokeColor=#8B2635;fontColor=#1C1C1C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="545" y="1148" width="190" height="50" as="geometry" /></mxCell>

        <!-- ============ PHASE 7 · QC / REVAMP ============ -->
        <mxCell id="G1" value="keyframes-review.ts → settled keyframe per scene → review.html + PNGs → Drive" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDFBF9;strokeColor=#1C1C1C;fontColor=#1C1C1C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="1242" width="380" height="44" as="geometry" /></mxCell>
        <mxCell id="G2" value="Claude Design QC — fan-out vision agents grade every keyframe → REPORT + fix-queue" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDFBF9;strokeColor=#1C1C1C;fontColor=#1C1C1C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="1298" width="380" height="44" as="geometry" /></mxCell>
        <mxCell id="G3" value="FIX: foundation tokens + parallel component builders&#10;→ npm run check (typecheck · lint · parity) → Codex verify → commit" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FDFBF9;strokeColor=#1C1C1C;fontColor=#1C1C1C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="1354" width="380" height="56" as="geometry" /></mxCell>
        <mxCell id="gnote" value="TWO-MODEL PROOF  (/goal overnight loop)&#10;• Claude = builder + checker;  Codex = independent reviewer at gates&#10;• 'done' = falsifiable proof (artifact), never agreement&#10;• STATE.json ledger · hourly heartbeats · resumable after teardown&#10;• checkpoint commits on the agent branch — NO push" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#D8CFC4;fontColor=#1C1C1C;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="855" y="1250" width="365" height="150" as="geometry" /></mxCell>

        <!-- ============ PHASE 8 · DELIVER ============ -->
        <mxCell id="H1" value="publish:drive (publish-to-drive.ts) — only if gate:status == 0&#10;→ Drive: Module N — …/Lesson N.M — …/&#10;N.M Video.mp4  +  N.M Script.pdf  +  N.M Lesson Plan.pdf" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1C1C1C;strokeColor=#1C1C1C;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="450" y="1470" width="380" height="72" as="geometry" /></mxCell>
        <mxCell id="hnote" value="REVAMP delivery: v3 published ALONGSIDE v2&#10;(N.M Video v3.mp4) for side-by-side comparison.&#10;Originals are never deleted / overwritten." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF7E6;strokeColor=#D8CFC4;fontColor=#1C1C1C;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="855" y="1472" width="365" height="68" as="geometry" /></mxCell>

        <!-- ============ EDGES ============ -->
        <mxCell id="e_a1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1C1C1C;endArrow=block;" edge="1" parent="1" source="inA1" target="forEach"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_a2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1C1C1C;endArrow=block;" edge="1" parent="1" source="inA2" target="forEach"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_a3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1C1C1C;endArrow=block;" edge="1" parent="1" source="inA3" target="forEach"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_fe_b1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1C1C1C;endArrow=block;" edge="1" parent="1" source="forEach" target="B1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_b1_b2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1C1C1C;endArrow=block;" edge="1" parent="1" source="B1" target="B2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_b2_acc" value="claims" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8B2635;endArrow=block;fontColor=#8B2635;fontSize=10;dashed=1;" edge="1" parent="1" source="B2" target="acc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_acc_c1" value="verified" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8B2635;endArrow=block;fontColor=#8B2635;fontSize=10;dashed=1;" edge="1" parent="1" source="acc" target="C1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_b2_c1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1C1C1C;endArrow=block;" edge="1" parent="1" source="B2" target="C1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_c1_c2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1C1C1C;endArrow=block;" edge="1" parent="1" source="C1" target="C2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_c2_d1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1C1C1C;endArrow=block;" edge="1" parent="1" source="C2" target="D1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_d1_d2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1C1C1C;endArrow=block;" edge="1" parent="1" source="D1" target="D2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_d2_e1" value="BUILD ALL lesson.json FIRST → render serially AFTER" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8B2635;endArrow=block;fontColor=#8B2635;fontStyle=1;fontSize=10;" edge="1" parent="1" source="D2" target="E1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_e1_edec" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1C1C1C;endArrow=block;" edge="1" parent="1" source="E1" target="edec"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_edec_no" value="no — crash / timeout&#10;→ retry smaller batch · route around" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8B2635;dashed=1;endArrow=block;fontColor=#8B2635;fontSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="edec" target="E1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_edec_f1" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1C1C1C;endArrow=block;fontSize=10;" edge="1" parent="1" source="edec" target="F1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_f1_fdec" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1C1C1C;endArrow=block;" edge="1" parent="1" source="F1" target="fdec"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_fdec_h1" value="all green → DELIVER" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1C1C1C;endArrow=block;fontStyle=1;fontSize=10;" edge="1" parent="1" source="fdec" target="H1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_f1_g1" value="QC the&#10;rendered set" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1C1C1C;endArrow=block;fontSize=10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="F1" target="G1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_g1_g2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1C1C1C;endArrow=block;" edge="1" parent="1" source="G1" target="G2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_g2_g3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1C1C1C;endArrow=block;" edge="1" parent="1" source="G2" target="G3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_g3_e1" value="re-render v3&#10;(fixed components)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8B2635;dashed=1;endArrow=block;fontColor=#8B2635;fontStyle=1;fontSize=10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="G3" target="E1"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
