<mxfile host="app.diagrams.net" agent="video-pipeline" version="24.0.0">
  <diagram name="Video Pipeline (one page)" id="vid-pipe-1page">
    <mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2380" pageHeight="1660" math="0" shadow="0" background="#EDE8E3">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="How a lesson becomes a finished video — the whole pipeline, start to finish" style="text;html=1;fontStyle=1;fontSize=18;fontColor=#8B2635;align=left;" vertex="1" parent="1"><mxGeometry x="14" y="10" width="1100" height="28" as="geometry" /></mxCell>
        <mxCell id="symkey" value="KEY:   → &quot;then / passes to&quot;     ⇢ &quot;repeats for every lesson / loops back&quot;     ▮ crimson = slowest step (bottleneck)     ▮ green = idea to speed it up     ▮ amber = slow but necessary     ✦ = a check by Codex (a 2nd AI)" style="text;html=1;fontSize=12;fontColor=#1C1C1C;align=left;" vertex="1" parent="1"><mxGeometry x="14" y="40" width="2000" height="20" as="geometry" /></mxCell>

        <!-- ===== PHASE / TIME HEADER ===== -->
        <mxCell id="ph1" value="① PLAN + BUILD&#10;~20–40 min · runs in PARALLEL for all lessons at once" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EDE8E3;strokeColor=#D8CFC4;fontStyle=1;fontColor=#1C1C1C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="74" width="430" height="44" as="geometry" /></mxCell>
        <mxCell id="ph2" value="② AUDIO&#10;~3–8 min per lesson · parallel" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EDE8E3;strokeColor=#D8CFC4;fontStyle=1;fontColor=#1C1C1C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="645" y="74" width="235" height="44" as="geometry" /></mxCell>
        <mxCell id="ph3" value="③ RENDER — ONE lesson at a time · ~30 min each · hours for the full batch  ◀ THE SLOW STEP" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F7E6E7;strokeColor=#E0B8BC;fontStyle=1;fontColor=#8B2635;fontSize=11;" vertex="1" parent="1"><mxGeometry x="885" y="74" width="635" height="44" as="geometry" /></mxCell>
        <mxCell id="ph4" value="④ CHECK + REVIEW&#10;~2 min/lesson auto + ~18 min design review" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EDE8E3;strokeColor=#D8CFC4;fontStyle=1;fontColor=#1C1C1C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1525" y="74" width="345" height="44" as="geometry" /></mxCell>
        <mxCell id="ph5" value="⑤ DELIVER&#10;~1 min per lesson" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EDE8E3;strokeColor=#D8CFC4;fontStyle=1;fontColor=#1C1C1C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1875" y="74" width="290" height="44" as="geometry" /></mxCell>

        <!-- ===== LANE BACKGROUNDS ===== -->
        <mxCell id="laneSrcBg" value="" style="rounded=0;html=1;fillColor=#F2ECE5;strokeColor=#D8CFC4;" vertex="1" parent="1"><mxGeometry x="200" y="125" width="1965" height="115" as="geometry" /></mxCell>
        <mxCell id="laneBuildBg" value="" style="rounded=0;html=1;fillColor=#F2ECE5;strokeColor=#D8CFC4;" vertex="1" parent="1"><mxGeometry x="200" y="250" width="1965" height="185" as="geometry" /></mxCell>
        <mxCell id="laneAudioBg" value="" style="rounded=0;html=1;fillColor=#F2ECE5;strokeColor=#D8CFC4;" vertex="1" parent="1"><mxGeometry x="200" y="445" width="1965" height="115" as="geometry" /></mxCell>
        <mxCell id="laneRenderBg" value="" style="rounded=0;html=1;fillColor=#F7E6E7;strokeColor=#E0B8BC;" vertex="1" parent="1"><mxGeometry x="200" y="570" width="1965" height="195" as="geometry" /></mxCell>
        <mxCell id="laneGateBg" value="" style="rounded=0;html=1;fillColor=#F2ECE5;strokeColor=#D8CFC4;" vertex="1" parent="1"><mxGeometry x="200" y="775" width="1965" height="185" as="geometry" /></mxCell>
        <mxCell id="laneDeliverBg" value="" style="rounded=0;html=1;fillColor=#E8E6E0;strokeColor=#C9C2B6;" vertex="1" parent="1"><mxGeometry x="200" y="970" width="1965" height="110" as="geometry" /></mxCell>
        <mxCell id="laneOrchBg" value="" style="rounded=0;html=1;fillColor=#EFE7E8;strokeColor=#E0B8BC;" vertex="1" parent="1"><mxGeometry x="200" y="1090" width="1965" height="95" as="geometry" /></mxCell>

        <!-- ===== LANE LABELS ===== -->
        <mxCell id="lblSrc" value="WHAT WE START WITH" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E8E6E0;strokeColor=#C9C2B6;fontStyle=1;fontColor=#8B2635;fontSize=11;" vertex="1" parent="1"><mxGeometry x="14" y="125" width="184" height="115" as="geometry" /></mxCell>
        <mxCell id="lblBuild" value="PLAN + BUILD&#10;the lesson&#10;(Claude — many&#10;lessons at once)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E8E6E0;strokeColor=#C9C2B6;fontStyle=1;fontColor=#8B2635;fontSize=11;" vertex="1" parent="1"><mxGeometry x="14" y="250" width="184" height="185" as="geometry" /></mxCell>
        <mxCell id="lblAudio" value="VOICEOVER&#10;(every lesson,&#10;in parallel)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E8E6E0;strokeColor=#C9C2B6;fontStyle=1;fontColor=#8B2635;fontSize=11;" vertex="1" parent="1"><mxGeometry x="14" y="445" width="184" height="115" as="geometry" /></mxCell>
        <mxCell id="lblRender" value="RENDER MACHINE&#10;one lesson at a time&#10;(the bottleneck)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F2D6D9;strokeColor=#E0B8BC;fontStyle=1;fontColor=#8B2635;fontSize=11;" vertex="1" parent="1"><mxGeometry x="14" y="570" width="184" height="195" as="geometry" /></mxCell>
        <mxCell id="lblGate" value="CHECK + REVIEW&#10;auto quality gates&#10;+ design polish" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E8E6E0;strokeColor=#C9C2B6;fontStyle=1;fontColor=#8B2635;fontSize=11;" vertex="1" parent="1"><mxGeometry x="14" y="775" width="184" height="185" as="geometry" /></mxCell>
        <mxCell id="lblDeliver" value="DELIVER&#10;to Google Drive" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E8E6E0;strokeColor=#C9C2B6;fontStyle=1;fontColor=#1C1C1C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="14" y="970" width="184" height="110" as="geometry" /></mxCell>
        <mxCell id="lblOrch" value="WHO RUNS IT&#10;(Claude + Codex)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E8E6E0;strokeColor=#C9C2B6;fontStyle=1;fontColor=#8B2635;fontSize=11;" vertex="1" parent="1"><mxGeometry x="14" y="1090" width="184" height="95" as="geometry" /></mxCell>

        <!-- ===== SOURCES ===== -->
        <mxCell id="src" value="The course outline (WHAT to teach)  +  the creator's content &amp; teaching style (the &quot;feel&quot;)  +  the brand rules (HOW it looks: colors, fonts, 18 reusable scene designs)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#EDE8E3;strokeColor=#8B2635;fontColor=#1C1C1C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="150" width="480" height="62" as="geometry" /></mxCell>

        <!-- ===== PLAN + BUILD ===== -->
        <mxCell id="b1" value="Claude writes the lesson plan&#10;+ a storyboard of scenes" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FDFBF9;strokeColor=#1C1C1C;fontColor=#1C1C1C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="258" width="205" height="48" as="geometry" /></mxCell>
        <mxCell id="bacc" value="Fact-check every claim vs the AI&#10;tools' official docs (ChatGPT, Claude…)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFF7E6;strokeColor=#8B2635;fontColor=#1C1C1C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="318" width="240" height="44" as="geometry" /></mxCell>
        <mxCell id="b2" value="lesson.json — Lesson 1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FDFBF9;strokeColor=#1C1C1C;fontColor=#1C1C1C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="258" width="190" height="26" as="geometry" /></mxCell>
        <mxCell id="b3" value="lesson.json — Lesson 2" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FDFBF9;strokeColor=#1C1C1C;fontColor=#1C1C1C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="290" width="190" height="26" as="geometry" /></mxCell>
        <mxCell id="b4" value="lesson.json — …every lesson (all built in parallel)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FDFBF9;strokeColor=#1C1C1C;fontColor=#1C1C1C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="322" width="190" height="32" as="geometry" /></mxCell>
        <mxCell id="bnote" value="lesson.json = one file that fully describes a lesson: its scenes, on-screen text, and narration" style="text;html=1;fontSize=10;fontColor=#6B6B6B;align=left;" vertex="1" parent="1"><mxGeometry x="210" y="392" width="480" height="30" as="geometry" /></mxCell>

        <!-- ===== AUDIO ===== -->
        <mxCell id="au" value="Turn each lesson's narration text&#10;into a spoken voiceover (TTS),&#10;then sync it to that lesson's scenes" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FDFBF9;strokeColor=#1C1C1C;fontColor=#1C1C1C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="655" y="462" width="225" height="74" as="geometry" /></mxCell>

        <!-- ===== RENDER (serial chain) ===== -->
        <mxCell id="bnnote" value="◀ THE BOTTLENECK — every lesson must pass through here, ONE at a time. A computer draws every video frame, then encodes an MP4. ~30 min each." style="text;html=1;fontStyle=1;fontColor=#8B2635;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="892" y="576" width="900" height="18" as="geometry" /></mxCell>
        <mxCell id="r1" value="Render Lesson 1&#10;→ MP4 (~30 min)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#8B2635;strokeColor=#8B2635;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="892" y="602" width="160" height="50" as="geometry" /></mxCell>
        <mxCell id="r2" value="Render Lesson 2&#10;→ MP4 (~30 min)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#8B2635;strokeColor=#8B2635;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1132" y="602" width="160" height="50" as="geometry" /></mxCell>
        <mxCell id="r3" value="Render Lesson 3&#10;→ MP4 (~30 min)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#8B2635;strokeColor=#8B2635;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1372" y="602" width="160" height="50" as="geometry" /></mxCell>
        <mxCell id="rn" value="… every lesson&#10;(one after another)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#8B2635;strokeColor=#8B2635;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1612" y="602" width="160" height="50" as="geometry" /></mxCell>
        <mxCell id="rspec" value="&quot;Render&quot; = Remotion (a code-to-video tool) draws each frame from the lesson.json + design pieces, then encodes a 1080p MP4. The same render step repeats for every lesson." style="text;html=1;fontSize=10;fontColor=#8B2635;align=left;" vertex="1" parent="1"><mxGeometry x="892" y="660" width="900" height="30" as="geometry" /></mxCell>
        <mxCell id="crash" value="✗ KNOWN PROBLEM: on a loaded computer the render crashes (out of memory) after ~3–4 lessons. Fix: render one lesson per fresh run, and/or use a dedicated render computer." style="shape=note;html=1;whiteSpace=wrap;fillColor=#FBEDEE;strokeColor=#8B2635;fontColor=#8B2635;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1820" y="588" width="335" height="100" as="geometry" /></mxCell>

        <!-- ===== GATE + QC ===== -->
        <mxCell id="gates_ttl" value="REQUIRED before a video can ship (runs on EVERY lesson):" style="text;html=1;fontStyle=1;fontSize=10;fontColor=#1C1C1C;align=left;" vertex="1" parent="1"><mxGeometry x="220" y="782" width="500" height="14" as="geometry" /></mxCell>
        <mxCell id="g1" value="AUTOMATIC QUALITY GATES&#10;A·B·C·L·T  +  motion  +  sound  +  color&#10;(all must pass — decoded in the KEY below)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FDFBF9;strokeColor=#1C1C1C;fontColor=#1C1C1C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="220" y="800" width="320" height="60" as="geometry" /></mxCell>
        <mxCell id="gcodex" value="✦ Codex (a 2nd, different AI)&#10;independently re-checks → then it can ship" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#F7E6E7;strokeColor=#8B2635;fontColor=#8B2635;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="800" width="300" height="60" as="geometry" /></mxCell>
        <mxCell id="qc_ttl" value="SEPARATE, on a schedule — improves the look, NOT needed to publish:" style="text;html=1;fontStyle=1;fontSize=10;fontColor=#6B6B6B;align=left;" vertex="1" parent="1"><mxGeometry x="1005" y="782" width="520" height="14" as="geometry" /></mxCell>
        <mxCell id="g2" value="DESIGN REVIEW — grab one frame per scene; an AI &quot;looks&quot; at each &amp; writes a fix list" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FDFBF9;strokeColor=#C9C2B6;fontColor=#1C1C1C;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="1005" y="800" width="350" height="54" as="geometry" /></mxCell>
        <mxCell id="g3" value="Fix the shared design pieces&#10;(this is the &quot;v3&quot; design-polish pass)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FDFBF9;strokeColor=#C9C2B6;fontColor=#1C1C1C;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="1005" y="868" width="350" height="50" as="geometry" /></mxCell>

        <!-- ===== DELIVER ===== -->
        <mxCell id="d1" value="Copy to Google Drive for the team:&#10;Video + Script + Lesson Plan&#10;(only after the required checks are green)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#1C1C1C;strokeColor=#1C1C1C;fontColor=#FFFFFF;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1875" y="990" width="280" height="70" as="geometry" /></mxCell>

        <!-- ===== ORCHESTRATION ===== -->
        <mxCell id="o1" value="🟦 CLAUDE runs the whole thing (plans, builds, checks);  🟥 CODEX (a different AI) independently double-checks the work before videos ship — two AIs catch more than one.   Progress is saved so it can resume if interrupted, and it never overwrites your old videos." style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#EDE8E3;strokeColor=#8B2635;fontColor=#1C1C1C;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="210" y="1105" width="1945" height="64" as="geometry" /></mxCell>

        <!-- ===== KEY / GLOSSARY PANEL ===== -->
        <mxCell id="glosttl" value="PLAIN-ENGLISH KEY — what the words mean (no jargon)" style="text;html=1;fontStyle=1;fontSize=14;fontColor=#8B2635;align=left;" vertex="1" parent="1"><mxGeometry x="14" y="1200" width="900" height="24" as="geometry" /></mxCell>
        <mxCell id="glosA" value="WHO&#10;🟦 Claude — the AI that plans, builds &amp; checks the work (it runs many lessons at once).&#10;🟥 Codex — a different AI that independently re-checks before anything ships.&#10;🖥 Render machine — one computer; it renders one video at a time.&#10;Plan, build, voiceover &amp; review all run in PARALLEL across lessons — only RENDER is one-at-a-time." style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#FDFBF9;strokeColor=#C9C2B6;fontColor=#1C1C1C;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="14" y="1228" width="520" height="185" as="geometry" /></mxCell>
        <mxCell id="glosB" value="WORDS&#10;Render — turn a lesson into a video: a computer draws every frame, then encodes an MP4 (~30 min each).&#10;Lesson 1 / 2 … — each finished lesson video (2–8 min); they render one after another (the bottleneck).&#10;lesson.json — the file describing one lesson's scenes, text &amp; narration.&#10;TTS — text-to-speech (the AI voiceover).   MP4 — a standard video file.&#10;v1 / v2 / v3 — video versions (v1 = first cut · v2 = brand facelift · v3 = this design-polish pass)." style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#FDFBF9;strokeColor=#C9C2B6;fontColor=#1C1C1C;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="544" y="1228" width="560" height="185" as="geometry" /></mxCell>
        <mxCell id="glosC" value="THE QUALITY CHECKS (auto, before a video ships)&#10;A·B·C·L·T = 5 checks:  A — Accuracy (facts right) ·  B — Teaching (clear) ·&#10;C — Watchability (engaging, not boring) ·  L — Layout (nothing overlaps; on-brand) ·  T — Timing (right pace/length).&#10;motion = stays animated (not a slideshow) ·  sound = audible voiceover ·&#10;color = correct HD color (not washed-out).&#10;✦ Then Codex (the 2nd AI) re-checks before it ships." style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#FDFBF9;strokeColor=#C9C2B6;fontColor=#1C1C1C;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1114" y="1228" width="540" height="185" as="geometry" /></mxCell>

        <!-- ===== EFFICIENCY ===== -->
        <mxCell id="impttl" value="HOW TO MAKE IT FASTER — ideas (green) · costs we can't avoid (amber)" style="text;html=1;fontStyle=1;fontSize=14;fontColor=#8B2635;align=left;" vertex="1" parent="1"><mxGeometry x="14" y="1435" width="900" height="24" as="geometry" /></mxCell>
        <mxCell id="imp1" value="⚡ FIX THE BOTTLENECK (biggest win)&#10;• Use several render computers / the cloud at once → many videos render in parallel.&#10;• A dedicated render computer (no other apps open) → no out-of-memory crash." style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#E8F0E3;strokeColor=#5C8A4A;fontColor=#1C1C1C;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="14" y="1463" width="535" height="140" as="geometry" /></mxCell>
        <mxCell id="imp2" value="⚡ DO LESS RENDERING&#10;• Re-render only the SCENES that changed, not the whole lesson.&#10;• Lower-quality &quot;draft&quot; renders for review; full quality only for final.&#10;• Render just the still frames for quick design checks." style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#E8F0E3;strokeColor=#5C8A4A;fontColor=#1C1C1C;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="559" y="1463" width="535" height="140" as="geometry" /></mxCell>
        <mxCell id="imp3" value="⚡ DON'T LOSE PROGRESS&#10;• Render one lesson per fresh run — a crash loses 1 lesson, not the batch.&#10;• Auto-retry a failed lesson, then skip after 3 tries (never hang).&#10;• Run the design review on a 2nd computer while the render computer keeps going." style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#E8F0E3;strokeColor=#5C8A4A;fontColor=#1C1C1C;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1104" y="1463" width="535" height="140" as="geometry" /></mxCell>
        <mxCell id="imp5" value="⚠ SLOW BUT NECESSARY&#10;• High-quality encoding + 2× sharpening = crisp 1080p (final videos need it).&#10;• Voiceover generation takes time (it calls an outside service).&#10;• Copying 50–90 MB videos to Drive over the network.&#10;Trim these only for rough drafts, never the final." style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#FBF1DD;strokeColor=#C79A3A;fontColor=#1C1C1C;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1649" y="1463" width="506" height="140" as="geometry" /></mxCell>

        <!-- ===== EDGES (every one labeled in plain English) ===== -->
        <mxCell id="e1" value="decide what to teach + how it looks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1C1C1C;endArrow=block;fontSize=10;labelBackgroundColor=#F2ECE5;" edge="1" parent="1" source="src" target="b1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e1b" value="first, check the facts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1C1C1C;endArrow=block;fontSize=10;labelBackgroundColor=#F2ECE5;" edge="1" parent="1" source="b1" target="bacc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eacc" value="facts verified → write each lesson's data file" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1C1C1C;endArrow=block;fontSize=10;labelBackgroundColor=#F2ECE5;exitX=1;exitY=0.3;exitDx=0;exitDy=0;" edge="1" parent="1" source="bacc" target="b2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2b" value="⇢ one data file per lesson, all in parallel" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9A9A9A;endArrow=block;dashed=1;fontSize=9;fontColor=#6B6B6B;labelBackgroundColor=#F2ECE5;" edge="1" parent="1" source="b2" target="b4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="⇢ each lesson's narration → its own voiceover" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1C1C1C;endArrow=block;fontSize=10;labelBackgroundColor=#F2ECE5;" edge="1" parent="1" source="b4" target="au"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="once a lesson's data + voiceover are ready, it goes in the render line" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8B2635;endArrow=block;fontStyle=1;fontColor=#8B2635;fontSize=10;labelBackgroundColor=#F7E6E7;" edge="1" parent="1" source="au" target="r1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="then the next lesson" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8B2635;endArrow=block;fontSize=9;fontColor=#8B2635;labelBackgroundColor=#F7E6E7;" edge="1" parent="1" source="r1" target="r2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="then the next" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8B2635;endArrow=block;fontSize=9;fontColor=#8B2635;labelBackgroundColor=#F7E6E7;" edge="1" parent="1" source="r2" target="r3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="…and so on, one at a time" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8B2635;endArrow=block;fontSize=9;fontColor=#8B2635;labelBackgroundColor=#F7E6E7;" edge="1" parent="1" source="r3" target="rn"><mxGeometry relative="1" as="geometry" /></mxCell>
