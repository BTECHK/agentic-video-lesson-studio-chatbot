        <mxCell id="sub" value="read top → bottom   ·   → sequence   ·   ⇢ parallel / loop   ·   ▮ crimson = bottleneck   ·   ▮ amber = check / safety" style="text;html=1;fontSize=12;fontColor=#6B6B6B;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="900" height="18" as="geometry" /></mxCell>

        <!-- BANDS -->
        <mxCell id="b1" value="1 · INPUTS — sources of truth" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F2ECE5;strokeColor=#C9C2B6;verticalAlign=top;align=left;spacingTop=6;spacingLeft=12;fontStyle=1;fontColor=#8B2635;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="66" width="830" height="96" as="geometry" /></mxCell>
        <mxCell id="b2" value="2 · PLAN — per lesson · ∥ parallel (AI agents)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F2ECE5;strokeColor=#C9C2B6;verticalAlign=top;align=left;spacingTop=6;spacingLeft=12;fontStyle=1;fontColor=#8B2635;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="186" width="830" height="96" as="geometry" /></mxCell>
        <mxCell id="b3" value="3 · BUILD / CONVERT" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F2ECE5;strokeColor=#C9C2B6;verticalAlign=top;align=left;spacingTop=6;spacingLeft=12;fontStyle=1;fontColor=#8B2635;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="306" width="830" height="86" as="geometry" /></mxCell>
        <mxCell id="b4" value="4 · AUDIO — per lesson · ∥ parallel" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F2ECE5;strokeColor=#C9C2B6;verticalAlign=top;align=left;spacingTop=6;spacingLeft=12;fontStyle=1;fontColor=#8B2635;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="416" width="830" height="86" as="geometry" /></mxCell>
        <mxCell id="b5" value="5 · RENDER  ◀ bottleneck · SERIAL · ~30 min / lesson · hours for the full batch" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F7E6E7;strokeColor=#8B2635;verticalAlign=top;align=left;spacingTop=6;spacingLeft=12;fontStyle=1;fontColor=#8B2635;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="526" width="830" height="120" as="geometry" /></mxCell>
        <mxCell id="b6" value="6 · GATE — runs AFTER each render (never during)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F2ECE5;strokeColor=#C9C2B6;verticalAlign=top;align=left;spacingTop=6;spacingLeft=12;fontStyle=1;fontColor=#8B2635;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="670" width="830" height="86" as="geometry" /></mxCell>
        <mxCell id="b7" value="7 · QC + REVAMP — periodic design upgrade (the v3 loop)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F2ECE5;strokeColor=#C9C2B6;verticalAlign=top;align=left;spacingTop=6;spacingLeft=12;fontStyle=1;fontColor=#8B2635;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="830" height="92" as="geometry" /></mxCell>
        <mxCell id="b8" value="8 · DELIVER" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#1C1C1C;strokeColor=#1C1C1C;verticalAlign=top;align=left;spacingTop=6;spacingLeft=12;fontStyle=1;fontColor=#FFFFFF;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="896" width="830" height="74" as="geometry" /></mxCell>

        <!-- B1 boxes -->
        <mxCell id="b1a" value="&lt;b&gt;Course outline → course-map.json&lt;/b&gt;&lt;br&gt;= SCOPE (what to teach)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDFBF9;strokeColor=#C9C2B6;fontColor=#1C1C1C;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="56" y="98" width="252" height="52" as="geometry" /></mxCell>
        <mxCell id="b1b" value="&lt;b&gt;Content repo + Google Drive&lt;/b&gt;&lt;br&gt;= TASTE (frameworks, voice)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDFBF9;strokeColor=#C9C2B6;fontColor=#1C1C1C;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="320" y="98" width="252" height="52" as="geometry" /></mxCell>
        <mxCell id="b1c" value="&lt;b&gt;Brand contracts + tokens.ts&lt;/b&gt;&lt;br&gt;= DESIGN · 18 scene types" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDFBF9;strokeColor=#C9C2B6;fontColor=#1C1C1C;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="584" y="98" width="270" height="52" as="geometry" /></mxCell>

        <!-- B2 boxes -->
        <mxCell id="b2a" value="&lt;b&gt;lesson-plan&lt;/b&gt;&lt;br&gt;→ the lesson plan" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDFBF9;strokeColor=#C9C2B6;fontColor=#1C1C1C;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="56" y="218" width="230" height="52" as="geometry" /></mxCell>
        <mxCell id="b2b" value="&lt;b&gt;scene-contract.json + storyboard&lt;/b&gt;&lt;br&gt;18 scene types" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDFBF9;strokeColor=#C9C2B6;fontColor=#1C1C1C;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="298" y="218" width="248" height="52" as="geometry" /></mxCell>
        <mxCell id="b2c" value="&lt;b&gt;Gate A · accuracy sweep&lt;/b&gt;&lt;br&gt;verify claims vs official tool docs" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FBF1DD;strokeColor=#C79A3A;fontColor=#1C1C1C;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="558" y="218" width="296" height="52" as="geometry" /></mxCell>

        <!-- B3 boxes -->
        <mxCell id="b3a" value="&lt;b&gt;convert → lesson.json&lt;/b&gt;&lt;br&gt;render-strict (content/schemas/scene-types.ts)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDFBF9;strokeColor=#C9C2B6;fontColor=#1C1C1C;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="56" y="338" width="380" height="44" as="geometry" /></mxCell>
        <mxCell id="b3b" value="&lt;b&gt;author narration&lt;/b&gt;&lt;br&gt;2.96 words/sec · generate-script --check ≥ 75%" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDFBF9;strokeColor=#C9C2B6;fontColor=#1C1C1C;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="456" y="338" width="398" height="44" as="geometry" /></mxCell>

        <!-- B4 boxes -->
        <mxCell id="b4a" value="&lt;b&gt;tts:lesson&lt;/b&gt; (synthesize-lesson.ts)&lt;br&gt;ElevenLabs → Google → Kokoro" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDFBF9;strokeColor=#C9C2B6;fontColor=#1C1C1C;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="56" y="448" width="300" height="44" as="geometry" /></mxCell>
        <mxCell id="b4b" value="&lt;b&gt;align:lesson&lt;/b&gt;&lt;br&gt;sync audio ↔ scenes" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDFBF9;strokeColor=#C9C2B6;fontColor=#1C1C1C;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="376" y="448" width="220" height="44" as="geometry" /></mxCell>
        <mxCell id="b4c" value="&lt;b&gt;edit-safety&lt;/b&gt;&lt;br&gt;regen→align→regen · volumedetect" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FBF1DD;strokeColor=#C79A3A;fontColor=#1C1C1C;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="616" y="448" width="238" height="44" as="geometry" /></mxCell>

        <!-- B5 boxes -->
        <mxCell id="b5a" value="&lt;b&gt;render-lesson.ts → out/&amp;lt;id&amp;gt;.mp4&lt;/b&gt;&lt;br&gt;Remotion · SSAA 2× · CRF 18 · x264 slow · BT.709" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDFBF9;strokeColor=#C9C2B6;fontColor=#1C1C1C;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="56" y="558" width="420" height="48" as="geometry" /></mxCell>
        <mxCell id="b5b" value="&lt;b&gt;Lesson 1 ▸ Lesson 2 ▸ Lesson 3 ▸ …&lt;/b&gt;&lt;br&gt;one fresh process per lesson · retry ≤ 3 then skip" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDFBF9;strokeColor=#C9C2B6;fontColor=#1C1C1C;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="496" y="558" width="358" height="48" as="geometry" /></mxCell>
        <mxCell id="b5n" value="✗ crash ceiling: ffmpeg 0xC0000142 (desktop-heap) after ~3–4 in one batch → fix = one lesson per fresh process / dedicated box" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FBEDEE;strokeColor=#8B2635;fontColor=#8B2635;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="56" y="612" width="798" height="26" as="geometry" /></mxCell>

        <!-- B6 boxes -->
        <mxCell id="b6a" value="&lt;b&gt;gate:status → A·B·C·L·T&lt;/b&gt;&lt;br&gt;the 5 definition-of-done checks" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDFBF9;strokeColor=#C9C2B6;fontColor=#1C1C1C;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="56" y="702" width="232" height="44" as="geometry" /></mxCell>
        <mxCell id="b6b" value="&lt;b&gt;gate:motion&lt;/b&gt;&lt;br&gt;stays alive" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDFBF9;strokeColor=#C9C2B6;fontColor=#1C1C1C;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="300" y="702" width="170" height="44" as="geometry" /></mxCell>
        <mxCell id="b6c" value="&lt;b&gt;gate:media&lt;/b&gt;&lt;br&gt;audible · BT.709" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDFBF9;strokeColor=#C9C2B6;fontColor=#1C1C1C;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="482" y="702" width="180" height="44" as="geometry" /></mxCell>
        <mxCell id="b6d" value="&lt;b&gt;volumedetect&lt;/b&gt;&lt;br&gt;not silent" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDFBF9;strokeColor=#C9C2B6;fontColor=#1C1C1C;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="674" y="702" width="180" height="44" as="geometry" /></mxCell>

        <!-- B7 boxes -->
        <mxCell id="b7a" value="&lt;b&gt;keyframes-review&lt;/b&gt;&lt;br&gt;review.html + settled PNGs → Drive" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDFBF9;strokeColor=#C9C2B6;fontColor=#1C1C1C;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="56" y="812" width="246" height="50" as="geometry" /></mxCell>
        <mxCell id="b7b" value="&lt;b&gt;Claude Design QC&lt;/b&gt;&lt;br&gt;∥ vision agents grade frames → report" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDFBF9;strokeColor=#C9C2B6;fontColor=#1C1C1C;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="314" y="812" width="262" height="50" as="geometry" /></mxCell>
        <mxCell id="b7c" value="&lt;b&gt;fix → re-render v3&lt;/b&gt;&lt;br&gt;builders + npm run check + Codex" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDFBF9;strokeColor=#C9C2B6;fontColor=#1C1C1C;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="588" y="812" width="266" height="50" as="geometry" /></mxCell>

        <!-- B8 boxes -->
        <mxCell id="b8a" value="publish:drive — only if gate:status == 0" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#2C2C2A;strokeColor=#444441;fontColor=#FFFFFF;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="56" y="928" width="380" height="34" as="geometry" /></mxCell>
        <mxCell id="b8b" value="→ Drive Module/Lesson: Video + Script + Lesson Plan (v3 alongside)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#2C2C2A;strokeColor=#444441;fontColor=#FFFFFF;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="456" y="928" width="398" height="34" as="geometry" /></mxCell>

        <!-- ORCHESTRATION -->
        <mxCell id="orch" value="&lt;b&gt;WHO RUNS IT — the /goal two-model loop, spanning every phase:&lt;/b&gt;&lt;br&gt;🟦 Claude builds + checks · 🟥 Codex (different AI) independently verifies at the gates · STATE.json ledger · hourly heartbeats · resumable · checkpoint commits on a branch (no push)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EDE8E3;strokeColor=#8B2635;fontColor=#1C1C1C;fontSize=11;align=left;verticalAlign=top;spacingTop=6;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="986" width="830" height="48" as="geometry" /></mxCell>

        <!-- GLOSSARY -->
        <mxCell id="glos" value="&lt;b&gt;KEY — plain English&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Render&lt;/b&gt; = a computer (Remotion) draws every video frame from the lesson's data + design pieces, then encodes an MP4.&lt;br&gt;&lt;b&gt;lesson.json&lt;/b&gt; = one file describing a lesson's scenes, on-screen text &amp;amp; narration.   &lt;b&gt;TTS&lt;/b&gt; = text-to-speech (AI voiceover).&lt;br&gt;&lt;b&gt;A·B·C·L·T&lt;/b&gt; (gate:status) = &lt;b&gt;A&lt;/b&gt;ccuracy · &lt;b&gt;B&lt;/b&gt; Teaching · &lt;b&gt;C&lt;/b&gt; Watchability · &lt;b&gt;L&lt;/b&gt;ayout · &lt;b&gt;T&lt;/b&gt;iming.&lt;br&gt;&lt;b&gt;∥ parallel&lt;/b&gt; = many lessons at once (agents).   &lt;b&gt;serial&lt;/b&gt; = one at a time → why RENDER is the bottleneck.&lt;br&gt;&lt;b&gt;BT.709&lt;/b&gt; = standard HD color (not washed-out).   &lt;b&gt;SSAA 2×&lt;/b&gt; = render at 2× then shrink for crisp 1080p.&lt;br&gt;&lt;b&gt;✦ Codex&lt;/b&gt; = a 2nd, different AI that re-checks the work before it ships.&lt;br&gt;&lt;b&gt;v3&lt;/b&gt; = this design-polish version (v1 = first cut · v2 = brand facelift · v3 = QC fixes).&lt;br&gt;&lt;b&gt;scripts&lt;/b&gt;: render-lesson.ts · gate:* · tts/align:lesson · publish:drive · keyframes-review.&lt;br&gt;&lt;b&gt;▮ amber&lt;/b&gt; = an accuracy / safety check that protects quality (fact-check, audio edit-safety)." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F2ECE5;strokeColor=#C9C2B6;fontColor=#1C1C1C;fontSize=11;align=left;verticalAlign=top;spacingTop=8;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="1050" width="830" height="250" as="geometry" /></mxCell>

