  </diagram>
  <diagram name="Swimlanes · Timing · Bottlenecks" id="vid-pipe-2">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1940" pageHeight="1300" math="0" shadow="0" background="#EDE8E3">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p2-title" value="Video Pipeline — Swimlanes · Timing · Dependencies · Bottlenecks (big multi-module batch)" style="text;html=1;fontStyle=1;fontSize=16;fontColor=#8B2635;align=left;" vertex="1" parent="1"><mxGeometry x="12" y="10" width="900" height="30" as="geometry" /></mxCell>
        <mxCell id="p2-legend" value="serial → chain   ·   ∥ = parallel   ·   crimson = bottleneck   ·   green = improvement   ·   amber = unavoidable" style="text;html=1;fontSize=11;fontColor=#1C1C1C;align=right;" vertex="1" parent="1"><mxGeometry x="1180" y="14" width="740" height="22" as="geometry" /></mxCell>

        <!-- ===== TIME / PHASE HEADER ===== -->
        <mxCell id="p2-ph1" value="① PLAN + BUILD&#10;~20–40 min · PARALLEL ∥ across lessons" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EDE8E3;strokeColor=#D8CFC4;fontStyle=1;fontColor=#1C1C1C;fontSize=10;" vertex="1" parent="1"><mxGeometry x="165" y="54" width="350" height="44" as="geometry" /></mxCell>
        <mxCell id="p2-ph2" value="② AUDIO&#10;~3–8 min/lesson · ∥" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EDE8E3;strokeColor=#D8CFC4;fontStyle=1;fontColor=#1C1C1C;fontSize=10;" vertex="1" parent="1"><mxGeometry x="517" y="54" width="238" height="44" as="geometry" /></mxCell>
        <mxCell id="p2-ph3" value="③ RENDER — SERIAL ~30 min × N  ◀ BOTTLENECK" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F7E6E7;strokeColor=#E0B8BC;fontStyle=1;fontColor=#8B2635;fontSize=10;" vertex="1" parent="1"><mxGeometry x="757" y="54" width="558" height="44" as="geometry" /></mxCell>
        <mxCell id="p2-ph4" value="④ GATE + QC&#10;~2 min/lesson + QC ~18 min" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EDE8E3;strokeColor=#D8CFC4;fontStyle=1;fontColor=#1C1C1C;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1317" y="54" width="303" height="44" as="geometry" /></mxCell>
        <mxCell id="p2-ph5" value="⑤ DELIVER&#10;~1 min/lesson" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EDE8E3;strokeColor=#D8CFC4;fontStyle=1;fontColor=#1C1C1C;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1622" y="54" width="298" height="44" as="geometry" /></mxCell>

        <!-- ===== LANE BACKGROUNDS ===== -->
