        <mxCell id="s4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1C1C1C;strokeWidth=2;endArrow=block;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1C1C1C;strokeWidth=2;endArrow=block;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b5" target="b6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1C1C1C;strokeWidth=2;endArrow=block;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b6" target="b7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1C1C1C;strokeWidth=2;endArrow=block;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b7" target="b8"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- WITHIN-BAND EDGES -->
        <mxCell id="w1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B6B6B;strokeWidth=1.4;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b2a" target="b2b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="w2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B6B6B;strokeWidth=1.4;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b2b" target="b2c"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="w3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B6B6B;strokeWidth=1.4;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b3a" target="b3b"><mxGeometry relative="1" as="geometry" /></mxCell>
