        <!-- ===== LANE LABELS ===== -->
        <mxCell id="p2-lblSrc" value="SOURCES" style="rounded=0;html=1;fillColor=#E8E6E0;strokeColor=#C9C2B6;fontStyle=1;fontColor=#8B2635;fontSize=11;" vertex="1" parent="1"><mxGeometry x="12" y="110" width="148" height="110" as="geometry" /></mxCell>
        <mxCell id="p2-lblBuild" value="PLAN + BUILD&#10;(agents ∥)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E8E6E0;strokeColor=#C9C2B6;fontStyle=1;fontColor=#8B2635;fontSize=11;" vertex="1" parent="1"><mxGeometry x="12" y="225" width="148" height="165" as="geometry" /></mxCell>
        <mxCell id="p2-lblAudio" value="AUDIO" style="rounded=0;html=1;fillColor=#E8E6E0;strokeColor=#C9C2B6;fontStyle=1;fontColor=#8B2635;fontSize=11;" vertex="1" parent="1"><mxGeometry x="12" y="395" width="148" height="105" as="geometry" /></mxCell>
        <mxCell id="p2-lblRender" value="RENDER MACHINE&#10;(SERIAL · bottleneck)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#F2D6D9;strokeColor=#E0B8BC;fontStyle=1;fontColor=#8B2635;fontSize=11;" vertex="1" parent="1"><mxGeometry x="12" y="505" width="148" height="180" as="geometry" /></mxCell>
        <mxCell id="p2-lblGate" value="GATE + QC" style="rounded=0;html=1;fillColor=#E8E6E0;strokeColor=#C9C2B6;fontStyle=1;fontColor=#8B2635;fontSize=11;" vertex="1" parent="1"><mxGeometry x="12" y="690" width="148" height="160" as="geometry" /></mxCell>
        <mxCell id="p2-lblDeliver" value="DELIVER&#10;(Google Drive)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E8E6E0;strokeColor=#C9C2B6;fontStyle=1;fontColor=#1C1C1C;fontSize=11;" vertex="1" parent="1"><mxGeometry x="12" y="855" width="148" height="110" as="geometry" /></mxCell>
        <mxCell id="p2-lblOrch" value="ORCHESTRATION&#10;(Claude + Codex)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E8E6E0;strokeColor=#C9C2B6;fontStyle=1;fontColor=#8B2635;fontSize=11;" vertex="1" parent="1"><mxGeometry x="12" y="970" width="148" height="95" as="geometry" /></mxCell>

        <!-- ===== SOURCES ===== -->
        <mxCell id="p2-src" value="Outline = SCOPE  ·  Content + Drive = TASTE  ·  Brand contracts + tokens = DESIGN (18 scene types)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#EDE8E3;strokeColor=#8B2635;fontColor=#1C1C1C;fontSize=10;" vertex="1" parent="1"><mxGeometry x="175" y="135" width="470" height="60" as="geometry" /></mxCell>

        <!-- ===== PLAN + BUILD (parallel fan-out) ===== -->
        <mxCell id="p2-b1" value="lesson-plan → lesson plan&#10;+ scene-contract.json" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FDFBF9;strokeColor=#1C1C1C;fontColor=#1C1C1C;fontSize=10;" vertex="1" parent="1"><mxGeometry x="175" y="245" width="195" height="56" as="geometry" /></mxCell>
        <mxCell id="p2-b2" value="lesson.json — L1" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FDFBF9;strokeColor=#1C1C1C;fontColor=#1C1C1C;fontSize=10;" vertex="1" parent="1"><mxGeometry x="395" y="240" width="120" height="28" as="geometry" /></mxCell>
        <mxCell id="p2-b3" value="lesson.json — L2   ∥" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FDFBF9;strokeColor=#1C1C1C;fontColor=#1C1C1C;fontSize=10;" vertex="1" parent="1"><mxGeometry x="395" y="272" width="120" height="28" as="geometry" /></mxCell>
        <mxCell id="p2-b4" value="lesson.json — …Lₙ" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FDFBF9;strokeColor=#1C1C1C;fontColor=#1C1C1C;fontSize=10;" vertex="1" parent="1"><mxGeometry x="395" y="304" width="120" height="28" as="geometry" /></mxCell>
        <mxCell id="p2-acc" value="Gate A · accuracy sweep (vendor docs)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFF7E6;strokeColor=#8B2635;fontColor=#1C1C1C;fontSize=10;" vertex="1" parent="1"><mxGeometry x="175" y="312" width="195" height="44" as="geometry" /></mxCell>

        <!-- ===== AUDIO ===== -->
        <mxCell id="p2-au" value="tts:lesson → align:lesson&#10;(per lesson · parallelizable)&#10;ElevenLabs / Google / Kokoro" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FDFBF9;strokeColor=#1C1C1C;fontColor=#1C1C1C;fontSize=10;" vertex="1" parent="1"><mxGeometry x="525" y="410" width="215" height="74" as="geometry" /></mxCell>

        <!-- ===== RENDER (serial chain) ===== -->
        <mxCell id="p2-bnnote" value="◀ BOTTLENECK · everything funnels here · N lessons × ~30 min = hours serial · one machine, cannot parallelize on this box" style="text;html=1;fontStyle=1;fontColor=#8B2635;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="772" y="510" width="700" height="20" as="geometry" /></mxCell>
        <mxCell id="p2-r1" value="Render L1&#10;~30 min" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#8B2635;strokeColor=#8B2635;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="775" y="535" width="140" height="48" as="geometry" /></mxCell>
        <mxCell id="p2-r2" value="Render L2&#10;~30 min" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#8B2635;strokeColor=#8B2635;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="930" y="535" width="140" height="48" as="geometry" /></mxCell>
        <mxCell id="p2-r3" value="Render L3&#10;~30 min" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#8B2635;strokeColor=#8B2635;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1085" y="535" width="140" height="48" as="geometry" /></mxCell>
        <mxCell id="p2-rn" value="… × N&#10;(serial)" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#8B2635;strokeColor=#8B2635;fontColor=#FFFFFF;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1240" y="535" width="72" height="48" as="geometry" /></mxCell>
        <mxCell id="p2-crash" value="✗ CRASH CEILING — ffmpeg 0xC0000142 (Windows desktop-heap / memory) after ~3–4 renders on a loaded box → 'browser launch' fails cascade for the rest. Hit 3× this run. Mitigation: small batches + fresh process; real fix is a dedicated/clean render box." style="shape=note;html=1;whiteSpace=wrap;fillColor=#FBEDEE;strokeColor=#8B2635;fontColor=#8B2635;fontSize=10;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="775" y="595" width="537" height="78" as="geometry" /></mxCell>

        <!-- ===== GATE + QC ===== -->
        <mxCell id="p2-g1" value="gate:status (A·B·C·L·T)&#10;+ gate:motion + gate:media + volumedetect" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FDFBF9;strokeColor=#1C1C1C;fontColor=#1C1C1C;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1335" y="700" width="275" height="56" as="geometry" /></mxCell>
        <mxCell id="p2-g2" value="keyframes-review → Claude Design QC&#10;(∥ vision agents) → fix → re-render v3" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FDFBF9;strokeColor=#1C1C1C;fontColor=#1C1C1C;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1335" y="766" width="275" height="66" as="geometry" /></mxCell>

        <!-- ===== DELIVER ===== -->
        <mxCell id="p2-d1" value="publish:drive (gate-green only)&#10;Video + Script + Lesson Plan&#10;+ v2 / v3 alongside originals" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#1C1C1C;strokeColor=#1C1C1C;fontColor=#FFFFFF;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1635" y="875" width="245" height="70" as="geometry" /></mxCell>

        <!-- ===== ORCHESTRATION (cross-cutting) ===== -->
        <mxCell id="p2-o1" value="/goal two-model loop spans EVERY phase:  STATE.json ledger · hourly heartbeats · resumable after teardown · Claude builder + checker (∥) · Codex independent verify at gates · checkpoint commits on branch (NO push)" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#EDE8E3;strokeColor=#8B2635;fontColor=#1C1C1C;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="175" y="990" width="1700" height="58" as="geometry" /></mxCell>

        <!-- ===== EFFICIENCY / IMPROVEMENTS ===== -->
        <mxCell id="p2-impttl" value="EFFICIENCY ANALYSIS — improvement options (green) · unavoidable quality costs (amber)" style="text;html=1;fontStyle=1;fontSize=13;fontColor=#8B2635;align=left;" vertex="1" parent="1"><mxGeometry x="12" y="1082" width="900" height="24" as="geometry" /></mxCell>
        <mxCell id="p2-imp1" value="⚡ KILL THE BOTTLENECK (highest impact)&#10;• Cloud / render farm — N machines render in parallel (≈ N× faster)&#10;• Dedicated headless render box — no user Chrome tabs → ends the 0xC0000142 crash&#10;• Free RAM / reboot before a batch" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#E8F0E3;strokeColor=#5C8A4A;fontColor=#1C1C1C;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="12" y="1112" width="370" height="150" as="geometry" /></mxCell>
        <mxCell id="p2-imp2" value="⚡ RENDER LESS WORK&#10;• Scene-level cache — re-render only CHANGED scenes, not whole lessons&#10;• 1.5× supersample for QA proofs; 2× only for final masters&#10;• Keyframe-only proof render for QC (skip full encode)" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#E8F0E3;strokeColor=#5C8A4A;fontColor=#1C1C1C;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="394" y="1112" width="370" height="150" as="geometry" /></mxCell>
        <mxCell id="p2-imp3" value="⚡ FAIL-SAFE BATCHING&#10;• Batches ≤ 3 + a fresh process each (avoids cumulative crash)&#10;• Per-lesson done-signal — a crash loses 1 lesson, not the batch&#10;• Auto-retry failed lessons in a fresh process" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#E8F0E3;strokeColor=#5C8A4A;fontColor=#1C1C1C;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="776" y="1112" width="370" height="150" as="geometry" /></mxCell>
        <mxCell id="p2-imp4" value="⚡ OVERLAP SAFE WORK&#10;• Build + TTS + align already run parallel (agents) ✓&#10;• Run gate + keyframe-extract on a 2nd box while render box keeps going&#10;• Async / batched Drive publish" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#E8F0E3;strokeColor=#5C8A4A;fontColor=#1C1C1C;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1158" y="1112" width="370" height="150" as="geometry" /></mxCell>
        <mxCell id="p2-imp5" value="⚠ SLOW BUT UNAVOIDABLE (quality floor)&#10;• x264 'slow' preset + 2× supersample = crisp 1080p — final masters need it&#10;• TTS vendor API synthesis latency&#10;• 50–90 MB MP4 network copy to Drive&#10;These buy production-grade output; trim only for drafts." style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#FBF1DD;strokeColor=#C79A3A;fontColor=#1C1C1C;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1540" y="1112" width="380" height="150" as="geometry" /></mxCell>

        <!-- ===== EDGES (dependencies / handoffs) ===== -->
        <mxCell id="p2-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1C1C1C;endArrow=block;fontSize=9;" edge="1" parent="1" source="p2-src" target="p2-b1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1C1C1C;endArrow=block;fontSize=9;" edge="1" parent="1" source="p2-b1" target="p2-b2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2-e2b" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9A9A9A;endArrow=block;dashed=1;fontSize=9;" edge="1" parent="1" source="p2-b1" target="p2-b3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2-e2c" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9A9A9A;endArrow=block;dashed=1;fontSize=9;" edge="1" parent="1" source="p2-b1" target="p2-b4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2-e3" value="per-lesson narration → audio" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1C1C1C;endArrow=block;fontSize=9;" edge="1" parent="1" source="p2-b3" target="p2-au"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2-e4" value="REQUIRES: all lesson.json + audio ready&#10;(barrier) → then render serially" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8B2635;endArrow=block;fontStyle=1;fontColor=#8B2635;fontSize=9;" edge="1" parent="1" source="p2-au" target="p2-r1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2-e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8B2635;endArrow=block;" edge="1" parent="1" source="p2-r1" target="p2-r2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2-e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8B2635;endArrow=block;" edge="1" parent="1" source="p2-r2" target="p2-r3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2-e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8B2635;endArrow=block;" edge="1" parent="1" source="p2-r3" target="p2-rn"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2-e8" value="each render done → gate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1C1C1C;endArrow=block;fontSize=9;" edge="1" parent="1" source="p2-r3" target="p2-g1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2-e9" value="green → DELIVER" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1C1C1C;endArrow=block;fontStyle=1;fontSize=9;" edge="1" parent="1" source="p2-g1" target="p2-d1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2-e10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1C1C1C;endArrow=block;fontSize=9;" edge="1" parent="1" source="p2-g1" target="p2-g2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2-e11" value="↺ revamp loop — re-render v3 (back to serial render)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#8B2635;dashed=1;endArrow=block;fontColor=#8B2635;fontStyle=1;fontSize=9;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2-g2" target="p2-r1"><mxGeometry relative="1" as="geometry" /></mxCell>
