        <mxCell id="loop" value="⇢ re-render v3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8B2635;strokeWidth=2;dashed=1;endArrow=block;fontColor=#8B2635;fontSize=11;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b7" target="b5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="912" y="826" /><mxPoint x="912" y="586" /></Array></mxGeometry></mxCell>
