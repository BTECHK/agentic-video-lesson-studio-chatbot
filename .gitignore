# Ignore .claude/ machinery, but track committed quality-gate guarantees +
# the skills (shared with Instructor as part of the handoff).
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/skills/
.claude/settings.local.json
# Still ignore local-only machinery even though skills are tracked:
.claude/worktrees/

# transient download staging
.incoming/
.script-prompt.txt

# Generated lesson media artifacts (regenerated by the pipeline; not source)
content/lessons/*/audio/
content/lessons/*/align/
public/lessons/

# Gate C watch-gate sensor dumps (frames + transcripts; regenerated by gate:lesson).
# The verdict (review/watch-gate.md) IS tracked — only the bulky sensor inputs are ignored.
content/lessons/*/review/_sensors/

# Regeneration DAG cache (content hashes; rebuilt on demand, not source)
content/lessons/*/.regen-cache.json
# Remotion render props (injected per-render from lesson.json; regenerable)
content/lessons/*/.render-props.json

# Generated drafts + fact-check reports (Studio Generate; review-then-apply, not source)
content/lessons/*/script.draft.json
content/lessons/*/*.factcheck.json

# Studio Generate background-job status (runtime state for #44, not source)
content/lessons/*/.generate-status.json

# Staged Studio comments (durable local review state)
content/lessons/*/.comments.json

# Staged Studio edits (durable local review state)
content/lessons/*/.edits.json

# Teachable upload staging — generated MP4 masters + manifests are not source
publish/*
!publish/README.md

# Knowledge management stack
# GitNexus code-intelligence index (regenerable: `npx gitnexus analyze`)
.gitnexus/
# Wiki raw source material — staged locally, not source-of-truth; the curated
# wiki/ pages ARE tracked. (learnings.md, wiki/, CLAUDE.md, AGENTS.md stay tracked.)
raw/

# stray manual TTS test artifacts (real audio lives in <id>/audio/)
content/lessons/*.wav

# Saved-webpage render assets (cruft) — keep the readable HTML, drop the _files bundle
.planning/staging docs for improvments/*_files/

# Python bytecode from watch skill runtime
.claude/skills/**/__pycache__/

# skills.sh CLI drops machine-absolute symlinks here; track .agents/ content + skills-lock.json instead.
# Instructor recreates per-OS symlinks with `npx skills install`.
.claude/skills/remotion-best-practices

# per-machine Drive path for publish:drive
drive.local.json

# zip-extraction artifact (dup of claude-design-delta/upload/)
claude-design-delta/claude-design-delta-upload/

# Keyframe-review PNGs (regenerable via scripts/keyframes-review.ts; reviewed on Drive)
artifacts/keyframes-review/
agent-ops/overnight/HEARTBEAT
agent-ops/overnight/*.diff
agent-ops/overnight/*.log
agent-ops/overnight/run-*.err.log
