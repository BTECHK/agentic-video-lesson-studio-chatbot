# Tutor bot — standalone service config.
# Locally, populate from 1Password with: op run -- npm start   (refs stay out of the repo)

# LLM provider: "gemini" (Gemini API, free tier) or "mock" (deterministic, no key — tests/dev)
LLM_PROVIDER=mock

# Required when LLM_PROVIDER=gemini. Free key: https://aistudio.google.com/apikey
GOOGLE_CHATBOT_API_KEY=
# Optional model override (defaults to a current free-tier flash model)
GEMINI_MODEL=gemini-2.5-flash
# Gemini 2.5 "thinking" budget in tokens. Default 0 = OFF (recommended for grounded
# Q&A — leaving it on with a tight token cap causes empty/truncated answers).
GEMINI_THINKING_BUDGET=0

# Telegram bot token from @BotFather (required to actually run the Telegram channel)
TELEGRAM_BOT_TOKEN=

# Channel mode:
#   longpoll — bot dials out to Telegram (no inbound URL needed; great for local pilot)
#   webhook  — Telegram POSTs updates to PUBLIC_URL/telegram/webhook (Cloud Run default)
TELEGRAM_MODE=longpoll

# Public HTTPS base URL of this service (Cloud Run gives you one as *.run.app). Webhook mode only.
PUBLIC_URL=
# Shared secret sent in the X-Telegram-Bot-Api-Secret-Token header (webhook mode)
TELEGRAM_WEBHOOK_SECRET=

# HTTP port (Cloud Run sets PORT automatically; 3100 for local — :3000/:3001 are taken)
PORT=3100

# Per-user limits (cost/abuse guard)
RATE_LIMIT_PER_MIN=12
MAX_OUTPUT_TOKENS=1024

# Global daily request ceiling across ALL users/channels (quota/spend circuit
# breaker). 0 = unlimited. On the Gemini free tier the real spend cap is $0; raise
# this and it becomes the hard spend guard the moment you add a paid key.
DAILY_REQUEST_CAP=1000

# Telegram private-pilot allowlist: comma-separated chat ids the bot will answer.
# Empty = open to anyone who finds the bot. Set it to lock the bot to known testers
# (e.g. if the bot link gets forwarded around). Find your id via @userinfobot.
TELEGRAM_ALLOWED_CHAT_IDS=
