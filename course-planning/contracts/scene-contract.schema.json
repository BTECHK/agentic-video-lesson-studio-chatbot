{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Lesson Scene Contract",
  "description": "Per-lesson single source of truth. Components are pure render functions of this data + brand tokens. Edit copy/timing HERE, never in component code.",
  "type": "object",
  "required": ["id", "lesson", "fps", "scenes"],
  "properties": {
    "id": { "type": "string", "pattern": "^(topic-\\d+-lesson-\\d+)$" },
    "lesson": {
      "type": "object",
      "required": ["title", "module"],
      "properties": {
        "title": { "type": "string" },
        "topic": { "type": "string" },
        "module": { "type": "string" },
        "durationTargetMin": { "type": "number" }
      }
    },
    "buildStatus": { "enum": ["built", "designed-from-outline"] },
    "outlineSource": { "type": "string" },
    "fps": { "const": 30 },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "sceneType", "start", "duration"],
        "properties": {
          "id": { "type": "string" },
          "sceneType": {
            "enum": ["cover", "quote-card", "preview-band", "journey-map", "tool-card-reveal",
              "capability-table", "feature-grid", "recap-grid", "assignment-list", "comparison-chats",
              "setup-checklist", "voice-demo", "demo-cue", "dig-deeper", "tool-demo", "audit-quadrant",
              "screen-flow"]
          },
          "start": { "type": "integer", "minimum": 0 },
          "duration": { "type": "integer", "minimum": 1 },
          "delivery": { "enum": ["slide", "demo", "talking-head"] },
          "layout": { "type": "string" },
          "copy": { "type": "object" },
          "narration": { "type": "object" },
          "motion": { "type": "array" },
          "interactionNotes": { "type": "string" }
        }
      }
    },
    "openQuestions": { "type": "array" }
  }
}
