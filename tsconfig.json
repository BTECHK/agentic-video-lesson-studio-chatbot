{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "moduleResolution": "bundler",
    "noEmit": true
  },
  "include": ["src/**/*", "content/**/*", "scripts/**/*", "test/**/*", "remotion.config.ts"],
  "exclude": ["node_modules", "dist", "output"]
}
