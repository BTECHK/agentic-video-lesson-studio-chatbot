# LLM Provider: "anthropic" (requires API key) or "mock" (no key, for dev/testing)
LLM_PROVIDER=mock

# Required when LLM_PROVIDER=anthropic. Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the Claude model. Defaults to a current Sonnet.
# Examples: claude-sonnet-4-6 (default), claude-opus-4-7
ANTHROPIC_MODEL=

# Student access code (change in production)
ACCESS_CODE=

# Set to "true" to bypass access code validation in development
NEXT_PUBLIC_DEV_BYPASS=false

# Module scope for demo mode users
DEMO_MODULE_SCOPE=module-1
