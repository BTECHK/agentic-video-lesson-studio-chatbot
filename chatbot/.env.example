# LLM Provider — validated at startup; any other value fails closed (src/lib/config.ts):
#   mock        — free, deterministic stub (no key, no external calls)
#   claude-code — free live Tutor via the headless `claude -p` CLI; needs the Claude Code
#                 CLI + a logged-in session on the host (set this for the live demo)
#   anthropic   — paid API; requires ANTHROPIC_API_KEY
LLM_PROVIDER=mock

# Required when LLM_PROVIDER=anthropic. Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the Claude model. Defaults to a current Sonnet.
# Examples: claude-sonnet-4-6 (default), claude-opus-4-7
ANTHROPIC_MODEL=

# Student access code — REQUIRED. No hardcoded default: the app fails closed
# (denies all access) if this is unset. Set a real value before any deployment.
ACCESS_CODE=

# Set to "true" to bypass access code validation in LOCAL DEV ONLY.
# Ignored in production builds (NODE_ENV=production) — cannot be enabled there.
NEXT_PUBLIC_DEV_BYPASS=false

# Module scope for demo mode users
DEMO_MODULE_SCOPE=module-1

# Pipeline triggers — only the machine that has the render/ingest pipeline
# (Docker) should set these true. Leave false everywhere else: the UI then
# shows an honest "rebuild runs on the host" message and your edits stay
# staged (never lost). The in-app rebuild loop is wired in #47 — keep these
# false until then.
REGEN_TRIGGER_ENABLED=false
INGEST_TRIGGER_ENABLED=false
