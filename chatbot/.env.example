# LLM Provider - validated at startup; any other value fails closed (src/lib/config.ts):
#   mock        - free, deterministic stub (no key, no external calls)
#   claude-code - free live Tutor via the headless `claude -p` CLI; needs the Claude Code
#                 CLI + a logged-in session on the host (set this for the live demo)
#   anthropic   - paid API; requires ANTHROPIC_API_KEY
#   google      - Gemini API; requires GOOGLE_CHATBOT_API_KEY (or legacy GOOGLE_API_KEY)
LLM_PROVIDER=mock

# Required when LLM_PROVIDER=anthropic. Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the Claude model. Defaults to a current Sonnet.
# Examples: claude-sonnet-4-6 (default), claude-opus-4-7
ANTHROPIC_MODEL=

# Required when LLM_PROVIDER=google. Preferred dedicated key lane:
GOOGLE_CHATBOT_API_KEY=

# Legacy fallback (still accepted for compatibility):
GOOGLE_API_KEY=

# Optional Gemini model override. Default: gemini-2.5-flash
GOOGLE_MODEL=

# Local safety rail for testing (chatbot Google calls/day, midnight Pacific reset).
# Set lower/higher based on your current AI Studio quota dashboard.
GOOGLE_CHATBOT_DAILY_LIMIT=200
# Gemini quotas are per PROJECT, not per key. Separate keys improve compartmentalization,
# but they share limits when created in the same AI Studio project.

# Student access code - REQUIRED. No hardcoded default: the app fails closed
# (denies all access) if this is unset. Set a real value before any deployment.
ACCESS_CODE=

# Set to "true" to bypass access-code validation AND authorize the operator console
# (generate/ingest/regen/apply/comments/edits) in LOCAL DEV ONLY. This is the simplest
# way to run the whole console locally. Ignored in production (NODE_ENV=production) -
# cannot be enabled there.
NEXT_PUBLIC_DEV_BYPASS=false

# Operator token (#60): authorizes operator/write routes when NOT using the dev bypass
# (e.g. any non-local/production run). Deny-by-default - if unset, every operator/write
# route returns 401. Clients send it as the `x-operator-token` header. Leave blank to
# keep operator routes locked; set a strong random value to enable them.
OPERATOR_TOKEN=

# Module scope for demo mode users
DEMO_MODULE_SCOPE=module-1

# Pipeline triggers - only the machine that has the render/ingest pipeline
# (Docker) should set these true. Leave false everywhere else: the UI then
# shows an honest "rebuild runs on the host" message and your edits stay
# staged (never lost). The in-app rebuild loop is wired in #47 - keep these
# false until then.
REGEN_TRIGGER_ENABLED=false
INGEST_TRIGGER_ENABLED=false
